# Flask application and local SQLite database
FLASK_ENV=development
FLASK_APP=queme
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Omit DATABASE_URL to use backend/queme.db, or set a sqlite:/// URL for a custom file.


# Alternatively, omit the key values and use an AWS profile or attached IAM role.

# Speech transcription

# Adaptive interview thresholds use the evaluator's 0–10 content score.
# Strong performance raises the next question's difficulty; weak lowers it.
ADAPTIVE_STRONG_THRESHOLD=8
ADAPTIVE_WEAK_THRESHOLD=5

# Soft per-attempt AI evaluation budget; in-flight Ollama requests are not cancelled.
OLLAMA_LOCK_WAIT_TIMEOUT=30
OLLAMA_EVALUATION_BUDGET_SECONDS=600
OLLAMA_EVALUATION_MIN_TOKENS=700
OLLAMA_EVALUATION_MAX_TOKENS=1800


# Optional password-reset email

# Opt in to sending scoring text to OpenAI. Local-only remains the default.
EVALUATION_MODE=ollama
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-5.4-mini
OPENAI_EVALUATION_TIMEOUT=120

# Optional Groq second evaluator: EVALUATION_MODE=ollama_groq_sequential
GROQ_API_KEY=
GROQ_EVALUATION_MODEL=openai/gpt-oss-20b
GROQ_EVALUATION_TIMEOUT=120
